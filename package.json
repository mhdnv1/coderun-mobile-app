{
  "name": "myapp",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "npm run start:local",
    "start:local": "concurrently -n API,EXPO -c cyan,magenta \"npm run server\" \"npm run dev:local\"",
    "start:release": "npm run dev:release",
    "dev": "npm run dev:local",
    "dev:local": "dotenv -e .env.local -- expo start",
    "dev:release": "dotenv -e .env.release -- expo start",
    "android": "npm run android:local",
    "android:local": "dotenv -e .env.local -- expo start --android",
    "android:release": "dotenv -e .env.release -- expo start --android",
    "ios": "npm run ios:local",
    "ios:local": "dotenv -e .env.local -- expo start --ios",
    "ios:release": "dotenv -e .env.release -- expo start --ios",
    "web": "npm run web:local",
    "web:local": "dotenv -e .env.local -- expo start --web",
    "web:release": "dotenv -e .env.release -- expo start --web",
    "server": "json-server db.json --host localhost --port 3001",
    "typecheck": "tsc --noEmit",
    "check:expo": "expo install --check",
    "ci": "npm run check:expo && npm run typecheck && npm run build:release",
    "build:local": "dotenv -e .env.local -- expo export --platform web --output-dir dist/local",
    "build:release": "dotenv -e .env.release -- expo export --platform web --output-dir dist/release"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "@react-navigation/native": "^7.3.13",
    "@react-navigation/native-stack": "^7.18.5",
    "@reduxjs/toolkit": "^2.12.0",
    "expo": "~53.0.27",
    "expo-status-bar": "~2.2.3",
    "json-server": "^1.0.0-beta.15",
    "nativewind": "^4.1.23",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-web": "^0.20.0",
    "react-redux": "^9.3.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.0.10",
    "concurrently": "^10.0.3",
    "dotenv-cli": "^11.0.0",
    "typescript": "~5.8.3"
  },
  "private": true
}
